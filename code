#include <stdio.h> 

#include <string.h> 

  

#define MAX 20 

#define INF 99999 

  

int graph[MAX][MAX], dist[MAX], parent[MAX], visited[MAX]; 

int n, source; 

char name[MAX][50]; 

  

void enterGraph() { 

    int i, j, edges, u, v, w; 

  

    printf("\nEnter number of locations: "); 

    scanf("%d", &n); 

  

    for (i = 0; i < n; i++) { 

        printf("Enter location %d: ", i + 1); 

        scanf(" %[^\n]", name[i]); 

    } 

  

    for (i = 0; i < n; i++) 

        for (j = 0; j < n; j++) 

            graph[i][j] = (i == j) ? 0 : INF; 

  

    printf("\nEnter number of roads: "); 

    scanf("%d", &edges); 

  

    printf("\nEnter roads as: Source Destination Distance\n"); 

  

    for (i = 0; i < edges; i++) { 

        printf("Road %d: ", i + 1); 

        scanf("%d %d %d", &u, &v, &w); 

  

        if (u < 1 || u > n || v < 1 || v > n || w < 0) { 

            printf("Invalid input! Enter again.\n"); 

            i--; 

            continue; 

        } 

  

        graph[u - 1][v - 1] = w; 

        graph[v - 1][u - 1] = w; 

    } 

  

    printf("\nCampus graph created successfully!\n"); 

} 

  

void displayMatrix() { 

    int i, j; 

  

    printf("\nAdjacency Matrix:\n\n"); 

  

    for (i = 0; i < n; i++) { 

        for (j = 0; j < n; j++) { 

            if (graph[i][j] == INF) 

                printf("INF\t"); 

            else 

                printf("%d\t", graph[i][j]); 

        } 

        printf("\n"); 

    } 

} 

  

void dijkstra() { 

    int i, j, min, u; 

  

    for (i = 0; i < n; i++) { 

        dist[i] = INF; 

        parent[i] = -1; 

        visited[i] = 0; 

    } 

  

    dist[source] = 0; 

  

    for (i = 0; i < n; i++) { 

        min = INF; 

        u = -1; 

  

        for (j = 0; j < n; j++) { 

            if (!visited[j] && dist[j] < min) { 

                min = dist[j]; 

                u = j; 

            } 

        } 

  

        if (u == -1) 

            break; 

  

        visited[u] = 1; 

  

        for (j = 0; j < n; j++) { 

            if (!visited[j] && 

                graph[u][j] != INF && 

                dist[u] + graph[u][j] < dist[j]) { 

  

                dist[j] = dist[u] + graph[u][j]; 

                parent[j] = u; 

            } 

        } 

    } 

} 

  

void printPath(int v) { 

    if (parent[v] != -1) { 

        printPath(parent[v]); 

        printf(" -> "); 

    } 

  

    printf("%s", name[v]); 

} 

  

void displayPaths() { 

    int i; 

  

    dijkstra(); 

  

    printf("\nSource: %s\n\n", name[source]); 

    printf("%-25s %-15s %s\n", "Destination", "Distance", "Path"); 

    printf("------------------------------------------------------------\n"); 

  

    for (i = 0; i < n; i++) { 

        if (i == source) 

            continue; 

  

        if (dist[i] == INF) { 

            printf("%-25s %-15s No Path\n", name[i], "INF"); 

        } else { 

            printf("%-25s %-15d ", name[i], dist[i]); 

            printPath(i); 

            printf("\n"); 

        } 

    } 

} 

  

void displayDistances() { 

    int i; 

  

    dijkstra(); 

  

    printf("\nSource: %s\n\n", name[source]); 

  

    for (i = 0; i < n; i++) { 

        printf("%-25s : ", name[i]); 

  

        if (dist[i] == INF) 

            printf("Not Reachable\n"); 

        else 

            printf("%d\n", dist[i]); 

    } 

} 

  

int main() { 

    int choice; 

    int graphEntered = 0; 

    int sourceSelected = 0; 

  

    do { 

        printf("\n====================================\n"); 

        printf("     CAMPUS SHORTEST ROUTE FINDER\n"); 

        printf("       DIJKSTRA'S ALGORITHM\n"); 

        printf("====================================\n"); 

  

        printf("1. Enter Campus Graph\n"); 

        printf("2. Display Adjacency Matrix\n"); 

        printf("3. Select Source Location\n"); 

        printf("4. Find Shortest Distance\n"); 

        printf("5. Display Shortest Paths\n"); 

        printf("6. Display Distance from Source\n"); 

        printf("7. Exit\n"); 

  

        printf("\nEnter choice: "); 

        scanf("%d", &choice); 

  

        switch (choice) { 

  

            case 1: 

                enterGraph(); 

                graphEntered = 1; 

                sourceSelected = 0; 

                break; 

  

            case 2: 

                if (!graphEntered) 

                    printf("\nPlease enter the campus graph first.\n"); 

                else 

                    displayMatrix(); 

                break; 

  

            case 3: 

                if (!graphEntered) { 

                    printf("\nPlease enter the campus graph first.\n"); 

                    break; 

                } 

  

                printf("\nCampus Locations:\n"); 

  

                for (int i = 0; i < n; i++) 

                    printf("%d. %s\n", i + 1, name[i]); 

  

                printf("\nEnter source location: "); 

                scanf("%d", &source); 

  

                if (source < 1 || source > n) { 

                    printf("Invalid location!\n"); 

                    sourceSelected = 0; 

                } else { 

                    source--; 

                    sourceSelected = 1; 

                    printf("Source selected: %s\n", name[source]); 

                } 

  

                break; 

  

            case 4: 

                if (!graphEntered) 

                    printf("\nPlease enter the campus graph first.\n"); 

                else if (!sourceSelected) 

                    printf("\nPlease select a source location first.\n"); 

                else { 

                    dijkstra(); 

                    printf("\nShortest distances calculated successfully!\n"); 

                } 

                break; 

  

            case 5: 

                if (!graphEntered) 

                    printf("\nPlease enter the campus graph first.\n"); 

                else if (!sourceSelected) 

                    printf("\nPlease select a source location first.\n"); 

                else 

                    displayPaths(); 

                break; 

  

            case 6: 

                if (!graphEntered) 

                    printf("\nPlease enter the campus graph first.\n"); 

                else if (!sourceSelected) 

                    printf("\nPlease select a source location first.\n"); 

                else 

                    displayDistances(); 

                break; 

  

            case 7: 

                printf("\nThank you for using Campus Shortest Route Finder!\n"); 

                break; 

  

            default: 

                printf("\nInvalid choice!\n"); 

        } 

  

    } while (choice != 7); 

  

    return 0; 

} 

